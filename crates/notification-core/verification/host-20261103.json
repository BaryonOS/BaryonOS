  "implemented": [
    "Nonzero notification, producer, message-reference, and action-reference identifiers.",
    "Fixed-capacity storage with duplicate-ID and full-capacity refusal.",
    "Per-producer bounded rate windows, monotonic-time checks, explicit expiry, and dismissal.",
    "Producer exit removes its notifications and permanently rejects later posts for that producer identity.",
    "Locked-session display only exposes Public entries; private/sensitive message and action references are not returned."
  ],
  "limitations": [
    "No authenticated producer authority, per-app permission policy, native reader capability, persistent history, UI, or real producer consumer is integrated.",
    "Priority is display metadata only and grants no authorization.",
    "The bounded producer identity table is process-local and does not model persistent identity generations.",
    "This is a PARTIAL host-tested primitive, not an OS notification service or release evidence."
  ]
