+
+/// DIAG(R02 tick split): local only, never commit. Exhaustive guest-tick
+/// buckets: each mark charges the elapsed ticks to the bucket being left.
+pub mod diag {
+    use core::sync::atomic::{AtomicU64, Ordering::Relaxed};
+    pub const AWAY: usize = 0; pub const LOOP: usize = 1; pub const INPUT: usize = 2;
+    pub const RENDER: usize = 3; pub const SEND: usize = 4; pub const REPLY: usize = 5;
+    pub const TAIL: usize = 6; pub const N: usize = 7;
+    pub const RENDERED: usize = 0; pub const BLITS: usize = 1; pub const RETAINS: usize = 2;
+    pub const REPLIES: usize = 3; pub const LOOPS: usize = 4; pub const C: usize = 5;
+    static LAST: AtomicU64 = AtomicU64::new(u64::MAX);
+    pub static BUCKET: [AtomicU64; N] = [const { AtomicU64::new(0) }; N];
+    pub static COUNT: [AtomicU64; C] = [const { AtomicU64::new(0) }; C];
+    /// Full-repaint frames (>= 1000 blits): count, wall, buckets, counts.
+    pub static FULL: [AtomicU64; 2 + N + C] = [const { AtomicU64::new(0) }; 2 + N + C];
+    static START: [AtomicU64; 1 + N + C] = [const { AtomicU64::new(u64::MAX) }; 1 + N + C];
+    fn now() -> u64 {
+        #[cfg(all(target_arch = "x86_64", target_os = "none"))]
+        { nieuw_os_sdk_runtime::clock::now_monotonic().unwrap_or(0) }
+        #[cfg(not(all(target_arch = "x86_64", target_os = "none")))]
+        { 0 }
+    }
+    pub fn mark(leaving: usize) {
+        let t = now();
+        let l = LAST.swap(t, Relaxed);
+        if l != u64::MAX { BUCKET[leaving].fetch_add(t.saturating_sub(l), Relaxed); }
+    }
+    pub fn count(i: usize) { COUNT[i].fetch_add(1, Relaxed); }
+    pub fn frame_start() {
+        mark(RENDER);
+        START[0].store(LAST.load(Relaxed), Relaxed);
+        for i in 0..N { START[1 + i].store(BUCKET[i].load(Relaxed), Relaxed); }
+        for j in 0..C { START[1 + N + j].store(COUNT[j].load(Relaxed), Relaxed); }
+    }
+    pub fn frame_end() {
+        mark(TAIL);
+        let s0 = START[0].load(Relaxed);
+        let blits = COUNT[BLITS].load(Relaxed).wrapping_sub(START[1 + N + BLITS].load(Relaxed));
+        if s0 == u64::MAX || blits < 1000 { return; }
+        FULL[0].fetch_add(1, Relaxed);
+        FULL[1].fetch_add(LAST.load(Relaxed).saturating_sub(s0), Relaxed);
+        for i in 0..N { FULL[2 + i].fetch_add(BUCKET[i].load(Relaxed) - START[1 + i].load(Relaxed), Relaxed); }
+        for j in 0..C { FULL[2 + N + j].fetch_add(COUNT[j].load(Relaxed) - START[1 + N + j].load(Relaxed), Relaxed); }
+        START[0].store(u64::MAX, Relaxed);
+    }
+}
