+/// DIAG(R02 tick split): local only, never commit.
+mod cdiag {
+    use core::sync::atomic::{AtomicU64, Ordering::Relaxed};
+    pub const AWAY: usize = 0; pub const TOP: usize = 1; pub const INGRESS: usize = 2; pub const TAIL: usize = 3;
+    static LAST: AtomicU64 = AtomicU64::new(u64::MAX);
+    pub static BUCKET: [AtomicU64; 4] = [const { AtomicU64::new(0) }; 4];
+    pub static TURNS: AtomicU64 = AtomicU64::new(0);
+    /// Spans between Material frame completions with >= 1000 commits: count, buckets, commits, turns.
+    pub static FULL: [AtomicU64; 7] = [const { AtomicU64::new(0) }; 7];
+    static START: [AtomicU64; 7] = [const { AtomicU64::new(0) }; 7];
+    pub fn mark(leaving: usize) {
+        let t = nieuw_os_sdk_runtime::native::monotonic_ticks().unwrap_or(0);
+        let l = LAST.swap(t, Relaxed);
+        if l != u64::MAX { BUCKET[leaving].fetch_add(t.saturating_sub(l), Relaxed); }
+    }
+    pub fn turn() { TURNS.fetch_add(1, Relaxed); }
+    pub fn span(frame: u64, commits: u64) {
+        if frame == START[6].load(Relaxed) { return; }
+        let delta = commits.wrapping_sub(START[4].load(Relaxed));
+        if delta >= 1000 && START[6].load(Relaxed) != 0 {
+            FULL[0].fetch_add(1, Relaxed);
+            for i in 0..4 { FULL[1 + i].fetch_add(BUCKET[i].load(Relaxed) - START[i].load(Relaxed), Relaxed); }
+            FULL[5].fetch_add(delta, Relaxed);
+            FULL[6].fetch_add(TURNS.load(Relaxed) - START[5].load(Relaxed), Relaxed);
+        }
+        for i in 0..4 { START[i].store(BUCKET[i].load(Relaxed), Relaxed); }
+        START[4].store(commits, Relaxed); START[5].store(TURNS.load(Relaxed), Relaxed); START[6].store(frame, Relaxed);
+    }
+}
