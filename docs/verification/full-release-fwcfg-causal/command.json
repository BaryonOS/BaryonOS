[
  "/workspace/.nieuw-os-env/bin/qemu-system-x86_64",
  "-machine",
  "pc-q35-8.2",
  "-accel",
  "tcg,thread=single",
  "-cpu",
  "qemu64",
  "-smp",
  "1",
  "-m",
  "256M",
  "-nodefaults",
  "-display",
  "none",
  "-monitor",
  "none",
  "-serial",
  "stdio",
  "-nic",
  "none",
  "-no-reboot",
  "-drive",
  "if=pflash,unit=0,format=raw,readonly=on,file=/tmp/nieuw-os-fwcfg-causal-mzq81ths/OVMF_CODE_4M.fd",
  "-drive",
  "if=pflash,unit=1,format=raw,file=/tmp/nieuw-os-fwcfg-causal-mzq81ths/OVMF_VARS_4M.fd",
  "-drive",
  "if=virtio,index=0,format=raw,readonly=on,file=fat:/tmp/nieuw-os-fwcfg-causal-mzq81ths/esp",
  "-device",
  "isa-debug-exit,iobase=0xf4,iosize=0x04",
  "-drive",
  "if=none,id=volume,format=raw,cache=writeback,readonly=off,file=/tmp/nieuw-os-fwcfg-causal-mzq81ths/volume.img",
  "-device",
  "virtio-blk-pci,drive=volume,id=volblk,addr=0x5,disable-legacy=on,num-queues=1,queue-size=8,serial=NOS-SYSTEM-TEST",
  "-object",
  "rng-random,id=rng0,filename=/dev/urandom",
  "-device",
  "virtio-rng-pci,rng=rng0,id=rng,addr=0x6,disable-legacy=on,max-bytes=1048576,period=1000",
  "-netdev",
  "socket,id=net0,connect=127.0.0.1:40339",
  "-device",
  "virtio-net-pci,netdev=net0,id=net,addr=0x7,disable-legacy=on,mac=02:00:00:00:00:07,romfile=",
  "-fw_cfg",
  "name=opt/org.tianocore/VirtioNetSupport,string=no",
  "-fw_cfg",
  "name=opt/org.tianocore/IPv4Support,string=no",
  "-fw_cfg",
  "name=opt/org.tianocore/IPv6Support,string=no"
]
