(() => {
  "use strict";

  const searchIndex = __SEARCH_INDEX__;
  const form = document.querySelector(".site-search");
  const input = document.querySelector("#site-search-input");
  const status = document.querySelector("#search-result-status");
  const list = document.querySelector("#search-result-list");

  if (!form || !input || !status || !list) {
    return;
  }

  const normalize = (value) => value
    .normalize("NFKD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLocaleLowerCase("en")
    .replace(/[^a-z0-9%]+/g, " ")
    .trim();

  const searchable = searchIndex.map((entry) => ({
    ...entry,
    normalizedTitle: normalize(entry.title),
    normalizedSummary: normalize(entry.summary),
    normalizedText: normalize(entry.text),
  }));

  const makeResult = (entry) => {
    const item = document.createElement("li");
    const link = document.createElement("a");
    const group = document.createElement("span");
    const title = document.createElement("strong");
    const summary = document.createElement("span");

    link.className = "search-result-card";
    link.href = entry.route;
    group.className = "search-result-group";
    group.textContent = entry.group;
    title.textContent = entry.title;
    summary.textContent = entry.summary;
    link.append(group, title, summary);
    item.append(link);
    return item;
  };

  const score = (entry, query, terms) => {
    const combined = `${entry.normalizedTitle} ${entry.normalizedSummary} ${entry.normalizedText}`;
    if (!terms.every((term) => combined.includes(term))) {
      return -1;
    }
    let value = 0;
    if (entry.normalizedTitle.includes(query)) value += 20;
    if (entry.normalizedSummary.includes(query)) value += 8;
    if (entry.normalizedText.includes(query)) value += 2;
    for (const term of terms) {
      if (entry.normalizedTitle.includes(term)) value += 6;
      if (entry.normalizedSummary.includes(term)) value += 3;
      if (entry.normalizedText.includes(term)) value += 1;
    }
    return value;
  };

  const render = (rawQuery, updateAddress = true) => {
    const query = normalize(rawQuery);
    list.replaceChildren();

    if (updateAddress) {
      const url = new URL(window.location.href);
      if (rawQuery.trim()) url.searchParams.set("q", rawQuery.trim());
      else url.searchParams.delete("q");
      window.history.replaceState(null, "", url);
    }

    if (!query) {
      status.textContent = "Enter a word or phrase to search the visitor guides.";
      return;
    }

    const terms = query.split(/\s+/);
    const matches = searchable
      .map((entry) => ({ entry, value: score(entry, query, terms) }))
      .filter((match) => match.value >= 0)
      .sort((left, right) => right.value - left.value || left.entry.title.localeCompare(right.entry.title))
      .slice(0, 12);

    if (!matches.length) {
      status.textContent = `No pages found for “${rawQuery.trim()}”. Try a broader term or open all Docs topics.`;
      return;
    }

    status.textContent = `${matches.length} ${matches.length === 1 ? "page" : "pages"} found for “${rawQuery.trim()}”.`;
    list.append(...matches.map((match) => makeResult(match.entry)));
  };

  form.addEventListener("submit", (event) => {
    event.preventDefault();
    render(input.value);
  });

  input.addEventListener("input", () => render(input.value));

  document.addEventListener("keydown", (event) => {
    const target = event.target;
    const editing = target instanceof HTMLElement
      && (target.matches("input, textarea, select") || target.isContentEditable);
    if (event.key === "/" && !editing && !event.metaKey && !event.ctrlKey && !event.altKey) {
      event.preventDefault();
      input.focus();
    }
  });

  const initialQuery = new URLSearchParams(window.location.search).get("q") || "";
  input.value = initialQuery;
  render(initialQuery, false);
})();
