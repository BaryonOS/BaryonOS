# Preserve exact raw bytes of current parallel acceptance and review logs.
docs/verification/parallel-*/**/*.txt -text

# M6e gate evidence: exact serial/report bytes bound by SHA256SUMS.
docs/verification/m6e/**/*.txt -text
docs/verification/m6e/**/*.json -text
docs/verification/m6e/*.json -text
docs/verification/m6e/SHA256SUMS -text
docs/verification/s06/**/*.txt -text
docs/verification/s06/**/*.json -text
docs/verification/s06/*.json -text
docs/verification/s06/SHA256SUMS -text

# K05 gate evidence: exact serial/report bytes bound by SHA256SUMS.
docs/verification/k05/**/*.txt -text
docs/verification/k05/**/*.json -text
docs/verification/k05/*.json -text
docs/verification/k05/SHA256SUMS -text

# B01 gate evidence: exact serial/report bytes bound by SHA256SUMS.
docs/verification/b01/**/*.txt -text
docs/verification/b01/**/*.json -text
docs/verification/b01/*.json -text
docs/verification/b01/SHA256SUMS -text

# Native herstelhardening: behoud exact de vastgelegde seriële bewijsbytes.
# Firmware gebruikt CRLF; controleer overige whitespace zonder bewijsbytes te wijzigen.
docs/verification/native-recovery-hardening/**/*.txt -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
docs/verification/native-recovery-hardening/**/*.json -text
docs/verification/native-recovery-hardening/**/SHA256SUMS -text
