docs/verification/regression-m6b/**/*.txt -text
docs/verification/m6b-storage-errors/*.txt -text
docs/verification/m6b-errors-review/*.txt -text
docs/verification/m6b-storage-errors-checkpoint/*.txt -text
docs/verification/m6c/**/*.txt -text
docs/verification/m6c/*.txt -text
docs/verification/m6c-review/**/*.txt -text
docs/verification/m6c-review/*.txt -text
docs/verification/m6c-ready/*.txt -text
docs/verification/m6c-console/*.txt -text
docs/verification/m6d/**/*.txt -text
docs/verification/m6d/**/*.json -text
docs/verification/m6d-m6b-regression/**/*.txt -text
docs/verification/m6d-m6b-regression/**/*.json -text
docs/verification/m6d-closeout/*.txt -text
